# ============================================
# Photo Reminder — Environment Variables
# ============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ──────────────────────────────────

# Your TimeTree login email
TIMETREE_EMAIL=you@example.com

# Your TimeTree password
TIMETREE_PASSWORD=yourpassword

# Your shared calendar ID (see discovery script below)
CALENDAR_ID=12345

# The TimeTree label IDs that should trigger photo reminders.
# Label IDs are 1–10 and map to the color labels in TimeTree.
# To find your label IDs, run: python discover.py
# Use comma separation for multiple labels.
TARGET_LABEL_IDS=3

# Bark push key(s) — found in the Bark iOS app.
# Open Bark on each phone, copy the push URL; the key is the path segment after the server.
# Separate multiple keys with commas to notify multiple people.
BARK_KEY=yourBarkKey,yourPartnersBarkKey

# ── Optional ──────────────────────────────────

# Bark server URL (default: https://api.day.app)
# Self-host if you prefer: https://github.com/Finb/bark-server
BARK_SERVER=https://api.day.app

# Notification group name in Bark (default: Photo Reminder)
BARK_GROUP=Photo Reminder

# URL to open when notification is tapped.
# Options:
#   shortcuts://run-shortcut?name=TakePhoto  → runs a Shortcut
#   (any https:// URL)
BARK_URL=shortcuts://run-shortcut?name=TakePhoto

# Minutes between repeat reminders during the same event (default: 30)
REMINDER_INTERVAL_MIN=30

# How many hours ahead to check for upcoming events (default: 12)
LOOKAHEAD_HOURS=12

# Your timezone offset from UTC (e.g. -5 for EST, -8 for PST, +1 for CET)
LOCAL_TZ_OFFSET_HOURS=-5

# State file path (default: /tmp/photo-reminder-state.json)
# On Fly.io with a volume, use /data/photo-reminder-state.json
STATE_FILE=/tmp/photo-reminder-state.json

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
